# 本地私有化环境变量模板
#
#   cp .env.private.example .env.private && chmod 600 .env.private
#   # 生成密钥后填进本文件：
#   openssl rand -base64 48   → BEACON_MASTER_KEY
#   openssl rand -hex 32     → REDIS_PASSWORD / POSTGRES_PASSWORD / BEACON_SETUP_TOKEN（各生成一次）
#
# 启动：
#   docker compose --env-file .env.private -f docker-compose.private.yml up -d --build
#
# 形态：BEACON_EDITION=private → 无短信/无支付；首次打开走装机向导（先填装机口令，再设管理员密码）。
# 协议：必须是 http://（不要 https）—— 否则登录 Cookie 会带 Secure，明文端口下 Safari 会丢 Cookie。

# ── compose 插值（也给服务用）────────────────────────────────
POSTGRES_USER=beacon
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=beacon
REDIS_PASSWORD=CHANGE_ME_REDIS

# ── 应用 ────────────────────────────────────────────────────
BEACON_EDITION=private
BEACON_ENV=prod
BEACON_QUEUE=bullmq

# 容器内连库用服务名；compose 也会用同密码覆盖 DATABASE_URL。
# 本机手工连库：postgresql://beacon:密码@127.0.0.1:5432/beacon?schema=beacon
DATABASE_URL=postgresql://beacon:CHANGE_ME_POSTGRES@postgres:5432/beacon?schema=beacon&connection_limit=5

# compose 会注入带密码的 REDIS_URL；这里占位即可
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379

# 【必填】BYOK 信封加密。丢了 = 已存的第三方 Key 解不开。
BEACON_MASTER_KEY=

# 【必填】装机向导口令（≥8 字符）。向导第一步要填它，防止局域网里谁先打开谁当管理员。
# 生成：openssl rand -hex 32
# 装机完成后可留在 .env（已初始化后向导关闭）；勿提交 git。
BEACON_SETUP_TOKEN=

# 直连 HTTP，无反代
BEACON_PUBLIC_URL=http://localhost:3000
BEACON_SITE_URL=http://localhost:3000
BEACON_TRUSTED_PROXY_HOPS=0

# 平台垫付 LLM：私有化默认关（走装机向导 / 设置页 BYOK）。
# 想省事可填一组 OpenAI 兼容端点当默认渠道：
# BEACON_DEFAULT_LLM_BASE_URL=https://api.deepseek.com
# BEACON_DEFAULT_LLM_API_KEY=
# BEACON_DEFAULT_LLM_MODEL=deepseek-chat

# 不要配短信 / 微信支付（私有化形态没有这些面）
# 不要设 BEACON_HTTP_PROXY（本编排无 xray）
