# 本地 Docker（SQLite + 开发态 Mock）：零 Redis / 零 Postgres / 零 API Key。
# 用法见 docker-compose.local.yml。
FROM node:20-slim

RUN apt-get update -y \
  && apt-get install -y openssl ca-certificates zip \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# 保持 prisma/schema.prisma 的 sqlite provider（不要覆盖成 postgres）
ENV DATABASE_URL="file:/app/data/beacon.db"
ENV NEXT_TELEMETRY_DISABLED=1
# 明确开发态：Mock 短信 / 进程内队列 / 内置弱主密钥
ENV NODE_ENV=development
ENV BEACON_ENV=dev

RUN npx prisma generate

COPY scripts/docker-local-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /app/data

EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
